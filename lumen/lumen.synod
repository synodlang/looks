# package lumen
use std/disk
use std/lesson
use std/lists
use std/look
use std/net
use std/sim
use std/text
use std/theme

# The ring settles in with a slow push of the camera; a counter will roll with the messages sent
when sim.Started
  look.Layout "ring"
  look.Focus look.Center zoom 1.12 over 0s
  look.Focus look.Center zoom 1 over 1200ms
  draw (look.Counter 0) as total for "total"
  look.Role total as "value"
  look.Face total as "mono"
  look.Tween "x" of total to 58 over 0s
  look.Tween "y" of total to 40 over 0s
  draw (look.Label "messages") as unit
  look.Role unit as "caption"
  look.Place unit below total

# A node is drawn on, then its state rows pop in one after another
when (sim.Added n)
  draw (look.Card for n) as card for n
  look.Reveal card
  draw (look.Icon "cross") as crash for n
  look.Stroke crash with theme.Critical
  look.Tween "opacity" of crash to 0 over 0s
  look.Place crash above card
  draw (look.Icon "disk") as drive for n
  look.Tween "opacity" of drive to 0 over 0s
  look.Place drive beside card
  set above to card
  set rows to {card}
  each i, line in (sim.StateRows n)
    draw (look.Label line) as row for (text.Join {(sim.Name n), "/", (text.From (i plus 1))})
      look.Tween "text" of row to (item i of (sim.StateRows n)) over 300ms
    look.Role row as "value"
    look.Face row as "mono"
    look.Place row below above
    set above to row
    set rows to (lists.Append row to rows)
  look.Enter rows every 60ms

# A changed field makes the card stand out
when (sim.Changed f of n from old to new)
  look.Effect "indicate" on (card of n)

# A message is a glowing particle that leaves a short trail on a bent path
when (net.Sent m from a to b)
  draw (look.Circle 5) as particle for (net.Id m)
  look.Fill particle with (look.MessageColor m)
  look.Tween "halo" of particle to 1 over 0s
  look.Bend particle by 0.18
  look.Trail particle for 240ms
  look.Flight particle from (card of a) to (card of b) for m
  look.Tween "count" of (total of "total") to (net.Id m) over 200ms

when (net.Arrived m from a to b)
  look.Effect "ripple" on (card of b)
  look.Remove (particle of (net.Id m))

when (net.Dropped m from a to b because r)
  look.Effect "flash" on (particle of (net.Id m))
  look.Remove (particle of (net.Id m))

when (sim.Crashed n)
  if (theme.NodeFill is "solid")
    look.Fill (card of n) with theme.Quiet
  if (theme.NodeFill is "outline")
    look.Stroke (card of n) with theme.Quiet
  look.Tween "opacity" of (crash of n) to 1 over 0s
  look.PopIn (crash of n)

when (sim.Restarted n)
  if (theme.NodeFill is "solid")
    look.Fill (card of n) with theme.Ink
  if (theme.NodeFill is "outline")
    look.Stroke (card of n) with theme.Ink
  look.Fade (crash of n) to 0
  look.Reveal (card of n)
  look.Effect "flash" on (card of n)

when (sim.Removed n)
  look.Remove (card of n)
  look.Remove (crash of n)
  look.Remove (drive of n)
  each i in (lists.Range 1 to (lists.Size (sim.StateRows n)))
    look.Remove (row of (text.Join {(sim.Name n), "/", (text.From i)}))

# A partition dashes the cards of the second group; healing makes every card solid again
when (net.Partitioned a from b)
  each x in b
    look.Dash (card of x) on 8 off 6

when net.Healed
  each x in sim.Nodes
    look.Dash (card of x) on 0 off 0
    look.Effect "flash" on (card of x)

# A write blinks a disk beside the card
when (disk.Written k on n)
  look.Tween "opacity" of (drive of n) to 1 over 0s
  look.PopIn (drive of n)
  after 900ms
    look.Fade (drive of n) to 0

# A broken rule frames the scene in Critical and names the rule
when (sim.Broken rule)
  draw look.Frame as alarm for "alarm"
  look.Stroke alarm with theme.Critical
  draw (look.Label rule) as reason for "reason"
  look.Role reason as "caption"
  look.Tween "y" of reason to 46 over 0s
  look.Effect "sweep" on alarm
  look.Reveal reason
  after 1800ms
    look.Remove alarm
    look.Remove reason

# A lesson note writes itself at the foot of the scene
when (sim.Emitted lesson.Noted by origin)
  draw (look.Label lesson.Noted.Text) as note for "note"
  look.Role note as "caption"
  look.Tween "y" of note to 604 over 0s
  look.Reveal note

# Any other emitted event circles the card of the node that emitted it
when (sim.Emitted e by n)
  if (n is not sim.Nobody)
    look.Effect "circumscribe" on (card of n)

# The camera pulls back a little at the end
when sim.Ended
  look.Focus look.Center zoom 0.96 over 1500ms
