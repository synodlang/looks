# theme terminal
# scene ground
define Paper
  result #0B0F0B

# node cards, primary text
define Ink
  result #33FF66

# links, borders
define Line
  result #1F5F2F

# secondary text, idle nodes
define Quiet
  result #2E9E4F

# messages, the one thing to look at
define Accent
  result #FFB000

# success, committed
define Good
  result #7DFF9A

# candidate, pending
define Warning
  result #FFD24A

# broken invariant, crashed
define Critical
  result #FF5F4A

# message color 1
define Message1
  result #FFB000

# message color 2
define Message2
  result #33FF66

# message color 3
define Message3
  result #66D9FF

# message color 4
define Message4
  result #FF7AD9

# edge darkening, 0 to 1
define Vignette
  result 0.55

# outline wobble, 0 to 1
define Sketch
  result 0

# glow blur
define Glow
  result 18

# shadow strength, 0 to 1
define Shadow
  result 0

# outline width
define StrokeWidth
  result 2

# rect corners
define CornerRadius
  result 0

# node card shape: "card" or "circle"
define NodeShape
  result "card"

# node card fill: "solid" or "outline"
define NodeFill
  result "outline"

# link opacity
define LinkOpacity
  result 0.8

# motion curve: "smooth" or "spring"
define Easing
  result "smooth"

# camera drift
define Drift
  result 0

# sans face
define Sans
  result "JetBrains Mono"

# mono face
define Mono
  result "JetBrains Mono"

# title role
define TitleSize
  result 26

# label role
define LabelSize
  result 16

# value role
define ValueSize
  result 15

# caption role
define CaptionSize
  result 18

# title role
define TitleWeight
  result 700

# label, value, caption roles
define LabelWeight
  result 400

# letter spacing
define Tracking
  result 0.02

# `look.Frame` inset
define Margin
  result 4

# layout scale
define Fill
  result 1
