# package doodle
use std/disk
use std/lesson
use std/lists
use std/look
use std/net
use std/sim
use std/text
use std/theme

# Nodes stand in a ring inside a dashed frame
when sim.Started
  look.Layout "ring"
  draw look.Frame as frame
  look.Stroke frame with theme.Line
  look.Dash frame on 6 off 6
  look.Tween "opacity" of frame to 0.4 over 0s

# A node is a stick-figure: a small head above the card, its state in captions below
when (sim.Added n)
  draw (look.Card for n) as card for n
  look.Reveal card
  draw (look.Circle 10) as head for n
  look.Stroke head with theme.Ink
  look.Place head above card
  look.Reveal head
  draw (look.Icon "cross") as crash for n
  look.Stroke crash with theme.Critical
  look.Tween "opacity" of crash to 0 over 0s
  look.Place crash beside card
  draw (look.Icon "disk") as drive for n
  look.Tween "opacity" of drive to 0 over 0s
  look.Place drive below card
  set above to card
  each i, line in (sim.StateRows n)
    draw (look.Label line) as row for (text.Join {(sim.Name n), "/", (text.From (i plus 1))})
      look.Tween "text" of row to (item i of (sim.StateRows n)) over 300ms
    look.Role row as "caption"
    look.Place row below above
    set above to row
    look.Reveal row

# A change is written beside the card, then fades; a node shows one note at a time
when (sim.Changed f of n from old to new)
  draw (look.Label (text.Join {(text.From f), ": ", (text.From new)})) as note for n
  look.Role note as "caption"
  look.Place note beside (card of n)
  look.Reveal note
  after 1200ms
    look.Remove note

# A message is a little envelope with its type written above
when (net.Sent m from a to b)
  draw (look.Icon "mail") as mail for (net.Id m)
  look.Tween "scale" of mail to 0.625 over 0s
  draw (look.Label (net.Type m)) as tag
  look.Role tag as "caption"
  look.Place tag above mail
  draw (look.Group {mail, tag}) as dot for (net.Id m)
  look.Bend dot by 0.25
  look.Flight dot from (card of a) to (card of b) for m

when (net.Arrived m from a to b)
  look.Remove (dot of (net.Id m))

# A lost message turns into a cross, then goes
when (net.Dropped m from a to b because r)
  look.Tween "icon" of (mail of (net.Id m)) to "cross" over 200ms
  after 400ms
    look.Remove (dot of (net.Id m))

when (sim.Crashed n)
  look.Dash (card of n) on 4 off 4
  look.Tween "opacity" of (crash of n) to 1 over 0s
  look.Reveal (crash of n)

when (sim.Restarted n)
  look.Dash (card of n) on 0 off 0
  look.Fade (crash of n) to 0

when (sim.Removed n)
  look.Remove (card of n)
  look.Remove (head of n)
  look.Remove (crash of n)
  look.Remove (drive of n)
  each i in (lists.Range 1 to (lists.Size (sim.StateRows n)))
    look.Remove (row of (text.Join {(sim.Name n), "/", (text.From i)}))

# A partition dashes the cards of the second group; healing makes them solid
when (net.Partitioned a from b)
  each x in b
    look.Dash (card of x) on 8 off 6

when net.Healed
  each x in sim.Nodes
    look.Dash (card of x) on 0 off 0

# A write blinks a disk below the card
when (disk.Written k on n)
  look.Tween "opacity" of (drive of n) to 1 over 0s
  look.Reveal (drive of n)
  after 900ms
    look.Fade (drive of n) to 0

# A broken rule is written at the top and underlined with a dashed line
when (sim.Broken rule)
  draw (look.Label rule) as reason for "reason"
  look.Role reason as "caption"
  look.Tween "y" of reason to 70 over 0s
  draw (look.Rect (8 times (text.Size rule)) by 2) as underline for "underline"
  look.Stroke underline with theme.Critical
  look.Dash underline on 6 off 4
  look.Place underline below reason
  look.Reveal reason
  look.Reveal underline
  after 1800ms
    look.Remove reason
    look.Remove underline

# A lesson note is a caption at the foot of the scene
when (sim.Emitted lesson.Noted by origin)
  draw (look.Label lesson.Noted.Text) as note for "note"
  look.Role note as "caption"
  look.Tween "y" of note to 930 over 0s

# Any other emitted event is named beside the node that emitted it
when (sim.Emitted e by n)
  if (n is not sim.Nobody)
    draw (look.Label (net.Type e)) as event
    look.Role event as "caption"
    look.Place event beside (card of n)
    after 1200ms
      look.Remove event
